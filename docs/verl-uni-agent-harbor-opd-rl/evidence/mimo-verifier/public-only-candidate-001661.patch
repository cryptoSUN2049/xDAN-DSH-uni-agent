+class FriendshipManager(models.Manager):
+    def friends_for_user(self, user):
+        friendships = self.filter(
+            models.Q(from_user=user) | models.Q(to_user=user)
+        ).select_related("from_user", "to_user")
+        return [
+            {
+                "friend": friendship.to_user if friendship.from_user_id == user.pk else friendship.from_user,
+                "friendship": friendship,
+            }
+            for friendship in friendships
+        ]
+
+    def _between(self, user1, user2):
+        return self.filter(
+            models.Q(from_user=user1, to_user=user2)
+            | models.Q(from_user=user2, to_user=user1)
+        )
+
+    def are_friends(self, user1, user2):
+        return self._between(user1, user2).exists()
+
+    def remove(self, user1, user2):
+        return self._between(user1, user2).delete()
+
+

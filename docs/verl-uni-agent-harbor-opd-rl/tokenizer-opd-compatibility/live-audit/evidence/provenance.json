  "teacher_sampling_source_lines": [
    {
      "line": 36,
      "text": "    teacher_model_config: DistillationTeacherModelConfig,"
    },
    {
      "line": 37,
      "text": "    distillation_loss_config: DistillationLossConfig,"
    },
    {
      "line": 38,
      "text": ") -> dict[str, Any]:"
    },
    {
      "line": 39,
      "text": "    \"\"\"Get sampling parameters for teacher model when computing log probabilities for distillation.\"\"\""
    },
    {
      "line": 40,
      "text": "    # Temperature has no effect on prompt_logprobs: the teacher performs a forward pass over"
    },
    {
      "line": 41,
      "text": "    # existing tokens (no sampling). Always use temperature=1.0 regardless of the config value."
    },
    {
      "line": 42,
      "text": "    # The default distillation.yaml copies the student rollout temperature via Hydra interpolation"
    },
    {
      "line": 43,
      "text": "    # (temperature: ${oc.select:actor_rollout_ref.rollout.temperature}), which causes a spurious"
    },
    {
      "line": 44,
      "text": "    # crash when rollout.temperature != 1.0."
    },
    {
      "line": 45,
      "text": "    if teacher_model_config.inference.temperature != 1.0:"
    },
    {
      "line": 46,
      "text": "        logger.warning("
    },
    {
      "line": 47,
      "text": "            \"Teacher inference temperature is set to %.1f, but temperature has no effect \""
    },
    {
      "line": 48,
      "text": "            \"on prompt_logprobs (forward pass only). Using temperature=1.0.\","
    },
    {
      "line": 49,
      "text": "            teacher_model_config.inference.temperature,"
    },
    {
      "line": 50,
      "text": "        )"
    },
    {
      "line": 51,
      "text": "    num_logprobs = distillation_loss_config.topk if distillation_loss_config.loss_settings.use_topk else 0"
    },
    {
      "line": 52,
      "text": "    return {"
    },
    {
      "line": 53,
      "text": "        \"max_tokens\": 1,"
    },
    {
      "line": 54,
      "text": "        \"temperature\": 1.0,"
    },
    {
      "line": 55,
      "text": "        \"prompt_logprobs\": num_logprobs,"
    },
    {
      "line": 56,
      "text": "        \"detokenize\": False,"
    },
    {
      "line": 57,
      "text": "    }"
    },
    {
      "line": 58,
      "text": ""
    }
  ],

diff --git a/verl/trainer/distillation/mopd.py b/verl/trainer/distillation/mopd.py
new file mode 100644
index 00000000..e53b10d9
--- /dev/null
+++ b/verl/trainer/distillation/mopd.py
@@ -0,0 +1,173 @@
+"""Explicit MiMo objective adapters for uni-agent's version-pinned VERL patch.
+
+The mathematical kernels live in uni_agent.training.mopd_objectives. Importing
+an unpatched upstream VERL does not enable these modes.
+"""
+
+import torch
+
+from verl.utils import tensordict_utils as tu
+from verl.utils.metric import AggregationType, Metric
+from verl.workers.utils.padding import no_padding_2_padding
+
+MODES = {"mopd_pg_sequence", "mopd_top64_reverse", "mopd_flash_orm"}
+
+
+def valid_sequence_count(mask):
+    """Local valid trajectories before microbatch partition, excluding empty pads."""
+    values = mask.values() if mask.is_nested else mask
+    if not ((values == 0) | (values == 1)).all():
+        raise ValueError("MiMo requires binary trajectory masks")
+    if mask.is_nested:
+        return torch.stack([row.bool().any() for row in mask.unbind()]).sum()
+    return mask.bool().any(-1).sum()
+
+
+def validate_runtime(config, data):
+    valid_sequence_count(data["response_mask"])
+    if config.strategy not in ("fsdp", "fsdp2"):
+        raise NotImplementedError("MiMo objectives require FSDP")
+    if config.entropy_coeff != 0 or config.use_kl_loss:
+        raise ValueError("MiMo objectives forbid unimplemented entropy/reference KL terms")
+    if config.loss_agg_mode != "seq-mean-token-mean":
+        raise ValueError("MiMo objectives require seq-mean-token-mean")
+    for owner in (config, getattr(config, "engine", None), getattr(config, "model_config", None)):
+        if owner is None:
+            continue
+        if getattr(owner, "use_fused_kernels", False):
+            raise ValueError("MiMo objectives require use_fused_kernels=false")
+        if getattr(owner, "ulysses_sequence_parallel_size", 1) != 1:
+            raise ValueError("MiMo objectives require SP=1")
+        if getattr(owner, "tensor_parallel_size", 1) != 1:
+            raise ValueError("MiMo objectives require TP=1")
+    if tu.get_non_tensor_data(data, "use_fused_kernels", False):
+        raise ValueError("MiMo objectives require use_fused_kernels=false")
+    if tu.get_non_tensor_data(data, "sp_size", 1) != 1:
+        raise ValueError("MiMo objectives require SP=1")
+    temperature = tu.get_non_tensor_data(data, "temperature", 1.0)
+    if not torch.as_tensor(temperature).eq(1.0).all():
+        raise ValueError("MiMo initial recipes require temperature=1")
+    if "rollout_is_weights" in data:
+        raise ValueError("MiMo objectives forbid upstream rollout importance weights")
+
+
+def _padded(tensor):
+    return tensor.to_padded_tensor(0.0) if tensor.is_nested else tensor
+
+
+def topk_logits(config, distillation_config, data, student_logits, data_format):
+    from uni_agent.training.mopd_objectives import corrected_topk_reverse
+
+    validate_runtime(config, data)
+    if data_format not in ("thd", "bshd"):
+        raise ValueError("MiMo top64 supports only THD/BSHD")
+    from verl.utils.ulysses import get_ulysses_sequence_parallel_world_size
+
+    if get_ulysses_sequence_parallel_world_size() != 1:
+        raise ValueError("MiMo top64 requires SP=1")
+    teacher = data["teacher_logprobs"]
+    ids = data["teacher_ids"]
+    if not teacher.is_nested or not ids.is_nested:
+        raise ValueError("MiMo top64 requires native nested teacher payload")
+    if not torch.equal(teacher.offsets(), ids.offsets()):
+        raise ValueError("Teacher probability/candidate sequence offsets differ")
+    if teacher.shape[-1] != 64 or ids.shape[-1] != 64:
+        raise ValueError("MiMo top64 requires exactly 64 candidates")
+    # Teacher payload indexes NEXT-token distributions over the full packed
+    # sequence. Only response predictions are meaningful; final dummy rows and
+    # prompt/tool observations must not be validated as teacher candidates.
+    masks = []
+    response_masks = data["response_mask"].unbind()
+    prompts = data["prompts"]
+    prompt_lengths = (
+        prompts.offsets().diff() if prompts.is_nested else data["attention_mask"][:, : prompts.shape[1]].sum(-1)
+    )
+    responses = data["responses"]
+    response_lengths = (
+        responses.offsets().diff() if responses.is_nested else data["attention_mask"][:, prompts.shape[1] :].sum(-1)
+    )
+    for row, mask, plen, rlen in zip(teacher.unbind(), response_masks, prompt_lengths, response_lengths, strict=True):
+        if row.shape[0] != int(plen) + int(rlen):
+            raise ValueError("Teacher sequence length does not match prompt plus response")
+        valid = torch.zeros(row.shape[0], dtype=torch.bool, device=row.device)
+        start, count = int(plen) - 1, int(rlen)
+        if start < 0 or start + count >= len(valid):
+            raise ValueError("Invalid prompt/response lengths for next-token alignment")
+        valid[start : start + count] = mask[:count].bool()
+        masks.append(valid)
+    if student_logits.shape[:2] == (1, teacher.values().shape[0]):
+        logq, candidates = teacher.values()[None], ids.values()[None]
+        valid = torch.cat(masks)[None]
+    elif data_format == "bshd":
+        # Explicit row padding avoids jagged to_padded_tensor shape metadata
+        # differences between PyTorch releases and preserves [B, S, K].
+        logq = torch.nn.utils.rnn.pad_sequence(list(teacher.unbind()), batch_first=True)
+        candidates = torch.nn.utils.rnn.pad_sequence(list(ids.unbind()), batch_first=True)
+        valid = torch.nn.utils.rnn.pad_sequence(masks, batch_first=True)
+    else:
+        raise ValueError("Student/teacher packed shape mismatch")
+    losses, metrics = corrected_topk_reverse(
+        student_logits,
+        candidates,
+        logq,
+        valid,
+        chunk_size=distillation_config.distillation_loss.chunked_topk_chunk_size,
+    )
+    return {
+        "distillation_losses": losses,
+        "student_mass": metrics["student_mass"],
+        "teacher_mass": metrics["teacher_mass"],
+    }
+
+
+def objective_loss(config, distillation_config, model_output, data):
+    from uni_agent.training.mopd_objectives import (
+        flash_orm_token_loss,
+        pg_sequence_token_loss,
+        sequence_mean,
+    )
+
+    validate_runtime(config, data)
+    lc = distillation_config.distillation_loss
+    mask = _padded(data["response_mask"]).bool()
+    global_b = tu.get_non_tensor_data(data, "global_valid_sequences", None)
+    if global_b is None:
+        raise ValueError("MiMo loss requires pre-microbatch global_valid_sequences")
+    dp_size = tu.get_non_tensor_data(data, "dp_size", 1)
+    # Diagnostic means are local microbatch statistics, not token-weighted
+    # global estimates when DP ranks or microbatches have unequal lengths.
+    metrics = {}
+    if lc.loss_mode == "mopd_top64_reverse":
+        tokens = no_padding_2_padding(model_output["distillation_losses"], data)
+        for name in ("student_mass", "teacher_mass"):
+            mass = no_padding_2_padding(model_output[name], data)[mask]
+            metrics["distillation/microbatch/" + name] = mass.mean().detach() if mass.numel() else 0.0
+    else:
+        logp = no_padding_2_padding(model_output["log_probs"], data)
+        logq = no_padding_2_padding(data["teacher_logprobs"], data).squeeze(-1)
+        if lc.loss_mode == "mopd_pg_sequence":
+            tokens, details = pg_sequence_token_loss(logp, logq, mask, advantage_clip=lc.mopd_advantage_clip)
+        elif lc.loss_mode == "mopd_flash_orm":
+            if "rollout_log_probs" not in data:
+                raise ValueError("Flash requires actual rollout_log_probs")
+            tokens, details = flash_orm_token_loss(
+                logp,
+                logq,
+                _padded(data["rollout_log_probs"]),
+                _padded(data["advantages"]),
+                mask,
+                alpha=lc.mopd_orm_alpha,
+                is_lower=lc.mopd_is_lower,
+                is_upper=lc.mopd_is_upper,
+            )
+        else:
+            raise ValueError("Unknown MiMo objective")
+        # Tensor diagnostics remain detached; do not serialize token arrays as
+        # scalar metrics. The framework persists original per-token evidence.
+        for name, value in details.items():
+            if isinstance(value, torch.Tensor) and value.ndim == 0:
+                metrics["distillation/microbatch/" + name] = value.detach()
+    loss = sequence_mean(tokens, mask, global_num_sequences=global_b, dp_size=dp_size)
+    metrics["distillation/loss"] = Metric(value=loss.detach(), aggregation=AggregationType.SUM)
+    metrics["distillation/valid_sequences"] = Metric(value=valid_sequence_count(mask), aggregation=AggregationType.SUM)
+    return loss, metrics

+def build_padding_per_token(source: Any, seq_len: int) -> torch.Tensor | None:
+    """Build a zero tensor with ``seq_len`` rows and the source's per-token trailing shape."""
+    if not isinstance(source, torch.Tensor):
+        return None
+    if source.dim() == 0:
+        return torch.zeros_like(source)
+    return torch.zeros((seq_len, *source.shape[1:]), dtype=source.dtype, device=source.device)
